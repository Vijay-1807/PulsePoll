# Backend environment - copy to backend/.env for local development.
# All of these have sensible localhost defaults in development mode.

APP_ENV=development
PORT=8080

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB=pulsepoll

# Redis (drives live counts, pub/sub, presence and rate limiting)
REDIS_URL=redis://localhost:6379

# Session signing - ALWAYS set a strong secret in production.
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_HOURS=168

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# Only needed when running behind a reverse proxy with a non-private IP.
# TRUSTED_PROXIES=10.0.0.0/8
